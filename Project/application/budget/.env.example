APP_NAME=BudgetLaravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://pbm.pharmacy.cmu.ac.th
ASSET_URL=/budget

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database_app_pbm
DB_PORT=3306
DB_DATABASE=pbm_budget
DB_USERNAME=webmaster
DB_PASSWORD=change_me

PBM_WITHDRAW_DB_HOST=database_app_pbm
PBM_WITHDRAW_DB_PORT=3306
PBM_WITHDRAW_DB_DATABASE=pbm_withdraw
PBM_WITHDRAW_DB_USERNAME=webmaster
PBM_WITHDRAW_DB_PASSWORD=change_me

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AUTH_TOKEN_REFRESH_URL=https://api.pharmacy.cmu.ac.th/api/tokenRefresh
STAFF_RX_TOKEN_REFRESH_URL=https://api.pharmacy.cmu.ac.th/api/tokenRefresh
PROJECT_PBM_DETAIL_URL=https://api.pharmacy.cmu.ac.th/api/detailProjectPBM
PROJECT_PBM_LIST_URL=https://api.pharmacy.cmu.ac.th/api/listProjectPBM

ONEPLANNING_URL=https://www.pos.oou.cmu.ac.th/oneplanning/api-calls/out-budget
ONEPLANNING_AUTH_CODE=
ONEPLANNING_PASS_KEY=
ONEPLANNING_REF_CODE=DIMPMC
ONEPLANNING_FISCAL_YEAR_TH=2569
